@startuml
!theme amiga

top to bottom direction
hide empty members
set separator none

title app.features.core.executory_processes

legend top left
  unchanged: drawn as on a plain diagram
  <color:#00C853>**+ added**</color> module / dependency (dashed)
  <color:#FF1744>**- removed**</color> module / dependency (dashed)
  <color:#C0392B>**NEW CYCLE**</color> cycle introduced (dashed)
  <color:#95A5A6>**cycle resolved**</color> dependency that remains
endlegend

class "models" as app.features.core.executory_processes.models <<(M, #9B59B6)>>
class "tasks" as app.features.core.executory_processes.tasks <<(M, #9B59B6)>>
class app.features.core.legal_cases <<(M, #BDC3C7)>> #line.dashed;text:7F8C8D
class app.features.core.legal_cases.usecases <<(M, #BDC3C7)>> #line.dashed;text:7F8C8D
class billing.invoices <<(+, #00C853) added>> #00C853;line.dashed

app.features.core.executory_processes.tasks ---> app.features.core.executory_processes.models
app.features.core.executory_processes.tasks ---> app.features.core.legal_cases
app.features.core.executory_processes.tasks ---> app.features.core.legal_cases.usecases
app.features.core.executory_processes.tasks -[#00C853,dashed,thickness=3]-> billing.invoices : added
@enduml

