@startuml
!theme amiga

top to bottom direction
hide empty members
set separator none

legend top left
  unchanged: drawn as on a plain diagram
  <color:#00C853>**+ added**</color> module / dependency (dashed)
  <color:#FF1744>**- removed**</color> module / dependency (dashed)
  <color:#C0392B>**NEW CYCLE**</color> cycle introduced (dashed)
  <color:#95A5A6>**cycle resolved**</color> dependency that remains
endlegend

package "app" as app {
  class "other" as app.other <<(M, #2ECC71)>>
  package "pkg" as app.pkg {
    class "pkg" as app.pkg.(module) <<(-, #FF1744) removed>> #FF1744;line.dashed
    class "child" as app.pkg.child <<(+, #00C853) added>> #00C853;line.dashed
  }
}

app.other ---> app.pkg
@enduml

