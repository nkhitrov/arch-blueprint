@startuml
!theme amiga

top to bottom direction
hide empty members

legend top left
  <color:#2ECC71>**+ added**</color> module / dependency
  <color:#E74C3C>**- removed**</color> module / dependency (dashed)
  <color:#95A5A6>**M**</color> unchanged, shown for context
  <color:#C0392B>**NEW CYCLE**</color> cycle introduced
  <color:#95A5A6>**cycle resolved**</color> dependency that remains
endlegend

package app1 {
  class app1.models <<(M, #D5D8DC)>>
}
package app2 {
  class app2.service <<(M, #D5D8DC)>>
}
package app3 {
  class app3.api <<(+, #2ECC71) added>>
}
package plugins {
  class plugins.auth.backend <<(-, #E74C3C) removed>> #line.dashed
}

app2 -[#E74C3C,dashed]-> plugins : removed
app3 -[#2ECC71,bold]-> app1 : added
@enduml

