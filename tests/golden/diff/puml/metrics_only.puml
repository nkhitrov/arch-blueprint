@startuml
!theme amiga

top to bottom direction
hide empty members

legend top left
  **No architectural changes**
  unchanged: drawn as on a plain diagram
  <color:#00C853>**+ added**</color> module / dependency (dashed)
  <color:#FF1744>**- removed**</color> module / dependency (dashed)
  <color:#C0392B>**NEW CYCLE**</color> cycle introduced (dashed)
  <color:#95A5A6>**cycle resolved**</color> dependency that remains
  metric: old → new (difference)
endlegend

package pkg_a {
  class pkg_a.core <<(M, #2ECC71)>> {
    fan_in: 1
    fan_out: 1
    instability: 0.5
  }
  class pkg_a.services <<(M, #2ECC71)>> {
    fan_in: 0 → 1 (+1)
    fan_out: 1
    instability: 1.0 → 0.5 (-0.5)
  }
}
package pkg_b {
  class pkg_b.util <<(M, #2ECC71)>> {
    fan_in: 2
    fan_out: 1 → 2 (+1)
    instability: 0.33 → 0.5 (+0.17)
  }
}

pkg_a <-[#C0392B,bold]-> pkg_b : edge_weight=2/1 → 2/2
@enduml

