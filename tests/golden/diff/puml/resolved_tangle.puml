@startuml
!theme amiga

top to bottom direction
hide empty members

legend top left
  unchanged: drawn as on a plain diagram
  <color:#00C853>**+ added**</color> module / dependency (dashed)
  <color:#FF1744>**- removed**</color> module / dependency (dashed)
  <color:#C0392B>**NEW CYCLE**</color> cycle introduced (dashed)
  <color:#95A5A6>**cycle resolved**</color> dependency that remains
endlegend

class api.handlers <<(M, #2ECC71)>>
class nest.a <<(M, #2ECC71)>>
class nest.b <<(M, #2ECC71)>>
class ring.a <<(M, #2ECC71)>>
class ring.b <<(M, #2ECC71)>>
class ring.c <<(M, #2ECC71)>>
package services {
  class services.engine <<(M, #2ECC71)>>
  class services.other <<(M, #2ECC71)>>
}

api.handlers -[#C0392B,bold]-> services
nest.a <-[#C0392B,bold]-> nest.b
ring.a -[#95A5A6,dashed]-> ring.b : cycle resolved
ring.b -[#95A5A6,dashed]-> ring.c : cycle resolved
ring.c -[#FF1744,dashed,thickness=2]-> ring.a : removed
services.engine -[#C0392B,bold]-> api.handlers
@enduml

