@startuml
!theme amiga

top to bottom direction
hide empty members
set separator none

legend top left
  unchanged: drawn as on a plain diagram
  <color:#00C853>**+ added**</color> module / dependency (dashed)
  <color:#FF1744>**- removed**</color> module / dependency (dashed)
  <color:#C0392B>**NEW CYCLE**</color> cycle introduced (dashed)
  <color:#95A5A6>**cycle resolved**</color> dependency that remains
endlegend

package "app1" as app1 {
  class "models" as app1.models <<(M, #2ECC71)>>
}
package "app2" as app2 {
  class "service" as app2.service <<(M, #2ECC71)>>
}
package "app3" as app3 {
  class "api" as app3.api <<(+, #00C853) added>> #00C853;line.dashed
}
package "plugins" as plugins {
  package "auth" as plugins.auth {
    class "backend" as plugins.auth.backend <<(-, #FF1744) removed>> #FF1744;line.dashed
  }
}

app2 -[#FF1744,dashed,thickness=2]-> plugins : removed
app3 -[#00C853,dashed,thickness=3]-> app1 : added
@enduml

