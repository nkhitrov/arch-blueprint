@startuml
!theme amiga

top to bottom direction
hide empty members

legend top left
  <color:#2ECC71>**+ added**</color> module / dependency
  <color:#E74C3C>**- removed**</color> module / dependency (dashed)
  <color:#95A5A6>**M**</color> unchanged, shown for context
  <color:#C0392B>**NEW CYCLE**</color> cycle introduced
  <color:#95A5A6>**cycle resolved**</color> dependency that remains
endlegend

package pkg_a {
  class pkg_a.core <<(M, #D5D8DC)>>
  class pkg_a.services <<(M, #D5D8DC)>>
}
package pkg_b {
  class pkg_b.util <<(M, #D5D8DC)>>
}

pkg_a <-[#C0392B,bold]-> pkg_b : NEW CYCLE
note on link
  **pkg_a -> pkg_b:**
  - core → util
  - services → util
  **pkg_b -> pkg_a:**
  - util → core
end note
@enduml

