@startuml
!theme amiga

top to bottom direction
hide empty members

legend top left
  unchanged: drawn as on a plain diagram
  <color:#00C853>**+ added**</color> module / dependency (dashed)
  <color:#FF1744>**- removed**</color> module / dependency (dashed)
  <color:#C0392B>**NEW CYCLE**</color> cycle introduced (dashed)
  <color:#95A5A6>**cycle resolved**</color> dependency that remains
endlegend

class api.handlers <<(M, #2ECC71)>>
package services {
  class services.engine <<(M, #2ECC71)>>
  class services.other <<(M, #2ECC71)>>
}

api.handlers -[#C0392B,dashed,thickness=3]-> services : NEW CYCLE
services.engine -[#C0392B,dashed,thickness=3]-> api.handlers : NEW CYCLE
@enduml

