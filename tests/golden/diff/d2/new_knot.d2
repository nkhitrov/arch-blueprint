direction: down
diff_legend: Legend {
  near: top-left
  unchanged: "unchanged: drawn as on a plain diagram"
  added: "+ added" {style.fill: "#00C853"; style.stroke-dash: 5}
  removed: "- removed" {style.fill: "#FF1744"; style.stroke-dash: 5}
  new_cycle: "NEW CYCLE" {style.stroke: "#C0392B"; style.stroke-width: 4; style.stroke-dash: 5}
  resolved: "cycle resolved" {style.stroke: "#95A5A6"; style.stroke-dash: 5}
}
"knot.a": {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

"knot.b": {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

"knot.c": {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}
"knot.a" <-> "knot.b": NEW CYCLE {style.stroke: "#C0392B"; style.stroke-width: 4; style.stroke-dash: 5}
"knot.b" -> "knot.c": NEW CYCLE {style.stroke: "#C0392B"; style.stroke-width: 4; style.stroke-dash: 5}
"knot.c" -> "knot.a": added {style.stroke: "#00C853"; style.stroke-width: 3; style.stroke-dash: 5}
"Cycle Details".grid.tangle_knot_a -- "knot.a" {style.stroke: "#C0392B"; style.stroke-dash: 3}
"Cycle Details".grid.tangle_knot_a -- "knot.b" {style.stroke: "#C0392B"; style.stroke-dash: 3}
"Cycle Details".grid.tangle_knot_a -- "knot.c" {style.stroke: "#C0392B"; style.stroke-dash: 3}
"Cycle Details": {
  style.fill: "#FEF9E7"
  style.stroke: "#F39C12"
  style.stroke-width: 2
  style.border-radius: 12

  grid: {
    label: ""
    grid-rows: 1
    grid-gap: 32
    style.stroke: transparent
    style.fill: transparent

    tangle_knot_a: |md
      **Cycle: knot.a, knot.b, knot.c**

      **knot.a -> knot.b:**

      - a → b

      **knot.b -> knot.a:**

      - b → a

      **knot.b -> knot.c:**

      - b → c

      **knot.c -> knot.a:**

      - c → a
    | {
      style.fill: "#FADBD8"
      style.stroke: "#C0392B"
      style.border-radius: 8
    }
  }
}
