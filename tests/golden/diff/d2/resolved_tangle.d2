  }
}
api.handlers -> services {style.stroke: "#C0392B"; style.stroke-width: 4}
nest.a <-> nest.b: CYCLE {style.stroke: "#C0392B"; style.stroke-width: 4}
ring.a -> ring.b: cycle resolved {style.stroke: "#95A5A6"; style.stroke-dash: 5}
ring.b -> ring.c: cycle resolved {style.stroke: "#95A5A6"; style.stroke-dash: 5}
ring.c -> ring.a: removed {style.stroke: "#FF1744"; style.stroke-dash: 5}
services.engine -> api.handlers {style.stroke: "#C0392B"; style.stroke-width: 4}
