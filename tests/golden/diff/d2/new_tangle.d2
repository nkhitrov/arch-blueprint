direction: down
diff_legend: Legend {
  near: top-left
  unchanged: "unchanged: drawn as on a plain diagram"
  added: "+ added" {style.fill: "#00C853"; style.stroke-dash: 5}
  removed: "- removed" {style.fill: "#FF1744"; style.stroke-dash: 5}
  new_cycle: "NEW CYCLE" {style.stroke: "#C0392B"; style.stroke-width: 4; style.stroke-dash: 5}
  resolved: "cycle resolved" {style.stroke: "#95A5A6"; style.stroke-dash: 5}
}
"api.handlers": {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

"nest.a": {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

"nest.b": {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

"ring.a": {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

"ring.b": {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

"ring.c": {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

"services": {
  shape: class
  style: {
    fill: "#3498DB"
  }
}

"services.engine": {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

"services.other": {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}
"api.handlers" -> "services" {style.stroke: "#C0392B"; style.stroke-width: 4}
"nest.a" <-> "nest.b": CYCLE {style.stroke: "#C0392B"; style.stroke-width: 4}
"ring.a" -> "ring.b": NEW CYCLE {style.stroke: "#C0392B"; style.stroke-width: 4; style.stroke-dash: 5}
"ring.b" -> "ring.c": NEW CYCLE {style.stroke: "#C0392B"; style.stroke-width: 4; style.stroke-dash: 5}
"ring.c" -> "ring.a": added {style.stroke: "#00C853"; style.stroke-width: 3; style.stroke-dash: 5}
"services.engine" -> "api.handlers" {style.stroke: "#C0392B"; style.stroke-width: 4}
"Cycle Details".grid.tangle_ring__a -- "ring.a" {style.stroke: "#C0392B"; style.stroke-dash: 3}
"Cycle Details".grid.tangle_ring__a -- "ring.b" {style.stroke: "#C0392B"; style.stroke-dash: 3}
"Cycle Details".grid.tangle_ring__a -- "ring.c" {style.stroke: "#C0392B"; style.stroke-dash: 3}
"Cycle Details": {
  style.fill: "#FEF9E7"
  style.stroke: "#F39C12"
  style.stroke-width: 2
  style.border-radius: 12

  grid: {
    label: ""
    grid-rows: 1
    grid-gap: 32
    style.stroke: transparent
    style.fill: transparent

    tangle_ring__a: |md
      **Cycle: ring.a, ring.b, ring.c**

      **ring.a -> ring.b:**

      - a → b

      **ring.b -> ring.c:**

      - b → c

      **ring.c -> ring.a:**

      - c → a
    | {
      style.fill: "#FADBD8"
      style.stroke: "#C0392B"
      style.border-radius: 8
    }
  }
}
