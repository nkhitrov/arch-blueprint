direction: right
diff_legend: Legend {
  near: top-left
  added: "+ added" {style.fill: "#2ECC71"}
  removed: "- removed" {style.fill: "#E74C3C"; style.stroke-dash: 5}
  context: "unchanged, shown for context" {style.fill: "#D5D8DC"}
  new_cycle: "NEW CYCLE" {style.stroke: "#C0392B"; style.stroke-width: 4}
  resolved: "cycle resolved" {style.stroke: "#95A5A6"; style.stroke-dash: 5}
}
pkg_a.core: {
  shape: class
  style: {
    fill: "#D5D8DC"
    font-color: "#2C3E50"
  }
}

pkg_a.services: {
  shape: class
  style: {
    fill: "#D5D8DC"
    font-color: "#2C3E50"
  }
}

pkg_b.util: {
  shape: class
  style: {
    fill: "#D5D8DC"
    font-color: "#2C3E50"
  }
}
pkg_a <-> pkg_b: NEW CYCLE {style.stroke: "#C0392B"; style.stroke-width: 4}
"Cycle Details": {
  style.fill: "#FEF9E7"
  style.stroke: "#F39C12"
  style.stroke-width: 2
  style.border-radius: 12

  grid: {
    label: ""
    grid-rows: 1
    grid-gap: 32
    style.stroke: transparent
    style.fill: transparent

    cycle_pkg_a_pkg_b: |md
      **pkg_a ↔ pkg_b**

      **pkg_a → pkg_b:**

      - core → util
      - services → util

      **pkg_b → pkg_a:**

      - util → core
    | {
      style.fill: "#FADBD8"
      style.stroke: "#C0392B"
      style.border-radius: 8
    }
  }
}
