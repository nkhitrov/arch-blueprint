direction: right
diff_legend: Legend {
  near: top-left
  unchanged: "unchanged: drawn as on a plain diagram"
  added: "+ added" {style.fill: "#00C853"; style.stroke-dash: 5}
  removed: "- removed" {style.fill: "#FF1744"; style.stroke-dash: 5}
  new_cycle: "NEW CYCLE" {style.stroke: "#C0392B"; style.stroke-width: 4; style.stroke-dash: 5}
  resolved: "cycle resolved" {style.stroke: "#95A5A6"; style.stroke-dash: 5}
}
pkg_a.core: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

pkg_a.services: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

pkg_b.util: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}
pkg_a <-> pkg_b: NEW CYCLE {style.stroke: "#C0392B"; style.stroke-width: 4; style.stroke-dash: 5}
"Details": {
  style.fill: "#FEF9E7"
  style.stroke: "#F39C12"
  style.stroke-width: 2
  style.border-radius: 12

  grid: {
    label: ""
    grid-rows: 1
    grid-gap: 32
    style.stroke: transparent
    style.fill: transparent

    cycle_pkg_a_pkg_b: |md
      **pkg_a ↔ pkg_b**

      **pkg_a → pkg_b.util:**

      - core
      - services

      **pkg_b.util → pkg_a:**

      - core
    | {
      style.fill: "#FADBD8"
      style.stroke: "#C0392B"
      style.border-radius: 8
    }
  }
}
