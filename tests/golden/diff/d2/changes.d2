direction: right
diff_legend: Legend {
  near: top-left
  added: "+ added" {style.fill: "#2ECC71"}
  removed: "- removed" {style.fill: "#E74C3C"; style.stroke-dash: 5}
  context: "unchanged, shown for context" {style.fill: "#D5D8DC"}
  new_cycle: "NEW CYCLE" {style.stroke: "#C0392B"; style.stroke-width: 4}
  resolved: "cycle resolved" {style.stroke: "#95A5A6"; style.stroke-dash: 5}
}
app1.models: {
  shape: class
  style: {
    fill: "#D5D8DC"
    font-color: "#2C3E50"
  }
}

app2.service: {
  shape: class
  style: {
    fill: "#D5D8DC"
    font-color: "#2C3E50"
  }
}

app3.api: {
  shape: class
  label: "+ api"
  style: {
    fill: "#2ECC71"
  }
}

plugins.auth.backend: {
  shape: class
  label: "- backend"
  style: {
    fill: "#E74C3C"
    stroke-dash: 5
  }
}
app2 -> plugins: removed {style.stroke: "#E74C3C"; style.stroke-dash: 5}
app3 -> app1: added {style.stroke: "#2ECC71"; style.stroke-width: 3}
