direction: down
api.handlers: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

nest.a: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

nest.b: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

ring.a: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

ring.b: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

ring.c: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

services.engine: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}

services.other: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
}
api <-> services: CYCLE {style.stroke: "#C0392B"; style.stroke-width: 4}
nest.a <-> nest.b: CYCLE {style.stroke: "#C0392B"; style.stroke-width: 4}
ring.a -> ring.b {style.stroke: "#C0392B"; style.stroke-width: 4}
ring.b -> ring.c {style.stroke: "#C0392B"; style.stroke-width: 4}
ring.c -> ring.a {style.stroke: "#C0392B"; style.stroke-width: 4}
"Cycle Details".grid.tangle_ring_a -- ring.a {style.stroke: "#C0392B"; style.stroke-dash: 3}
"Cycle Details".grid.tangle_ring_a -- ring.b {style.stroke: "#C0392B"; style.stroke-dash: 3}
"Cycle Details".grid.tangle_ring_a -- ring.c {style.stroke: "#C0392B"; style.stroke-dash: 3}
"Cycle Details": {
  style.fill: "#FEF9E7"
  style.stroke: "#F39C12"
  style.stroke-width: 2
  style.border-radius: 12

  grid: {
    label: ""
    grid-rows: 1
    grid-gap: 32
    style.stroke: transparent
    style.fill: transparent

    "cycle api services": |md
      **api ↔ services**

      **api → services:**

      - handlers → services

      **services → api:**

      - engine → handlers
    | {
      style.fill: "#FADBD8"
      style.stroke: "#C0392B"
      style.border-radius: 8
    }

    "cycle nest.a nest.b": |md
      **nest.a ↔ nest.b**

      **nest.a → nest.b:**

      - a → x

      **nest.b → nest.a:**

      - b → a
    | {
      style.fill: "#FADBD8"
      style.stroke: "#C0392B"
      style.border-radius: 8
    }

    tangle_ring_a: |md
      **Cycle: ring.a, ring.b, ring.c**

      **ring.a -> ring.b:**

      - a → b

      **ring.b -> ring.c:**

      - b → c

      **ring.c -> ring.a:**

      - c → a
    | {
      style.fill: "#FADBD8"
      style.stroke: "#C0392B"
      style.border-radius: 8
    }
  }
}
