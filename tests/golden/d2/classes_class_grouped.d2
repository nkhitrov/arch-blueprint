"Cycle Details": {
  style.fill: "#FEF9E7"
  style.stroke: "#F39C12"
  style.stroke-width: 2
  style.border-radius: 12

  grid: {
    label: ""
    grid-rows: 1
    grid-gap: 32
    style.stroke: transparent
    style.fill: transparent

    "cycle refs.cycles.Chicken refs.cycles.Egg": |md
      **refs.cycles.Chicken ↔ refs.cycles.Egg**

      **refs.cycles.Chicken → refs.cycles.Egg:**

      - Chicken → Egg

      **refs.cycles.Egg → refs.cycles.Chicken:**

      - Egg → Chicken
    | {
      style.fill: "#FADBD8"
      style.stroke: "#C0392B"
      style.border-radius: 8
    }

    tangle_refs__cycles__Paper: |md
      **Cycle: refs.cycles.Paper, refs.cycles.Rock, refs.cycles.Scissors**

      **refs.cycles.Paper -> refs.cycles.Rock:**

      - Paper → Rock

      **refs.cycles.Rock -> refs.cycles.Scissors:**

      - Rock → Scissors

      **refs.cycles.Scissors -> refs.cycles.Paper:**

      - Scissors → Paper
    | {
      style.fill: "#FADBD8"
      style.stroke: "#C0392B"
      style.border-radius: 8
    }
  }
}
