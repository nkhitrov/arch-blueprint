direction: right
pkg_a.core: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
  instability: 0.5
  fan-out: 1
  fan-in: 1
}

pkg_a.services: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
  instability: 1.0
  fan-out: 1
  fan-in: 0
}

pkg_b.util: {
  shape: class
  style: {
    fill: "#2ECC71"
  }
  instability: 0.33
  fan-out: 1
  fan-in: 2
}
pkg_a <-> pkg_b: CYCLE {style.stroke: "#C0392B"; style.stroke-width: 4}
"Details": {
  style.fill: "#FEF9E7"
  style.stroke: "#F39C12"
  style.stroke-width: 2
  style.border-radius: 12

  grid: {
    label: ""
    grid-rows: 1
    grid-gap: 32
    style.stroke: transparent
    style.fill: transparent

    cycle_pkg_a_pkg_b: |md
      **pkg_a ↔ pkg_b**

      **pkg_a → pkg_b.util:**

      - core
      - services

      **pkg_b.util → pkg_a:**

      - core
    | {
      style.fill: "#FADBD8"
      style.stroke: "#C0392B"
      style.border-radius: 8
    }
  }
}
"Legend": |md
  ### Legend

  ---

  - instability — fan-out / (fan-in + fan-out): 0 is stable, 1 is unstable
  - fan-out — how many modules this one depends on
  - fan-in — how many modules depend on this one

  ---

  **values on this diagram**

  - instability: 0.33, 0.5, 1.0
  - fan-out: 1×3
  - fan-in: 0, 1, 2
| {
  style.fill: "#FEF9E7"
  style.stroke: "#F39C12"
  style.border-radius: 8
}
