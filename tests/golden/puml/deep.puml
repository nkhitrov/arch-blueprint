@startuml
!theme amiga

top to bottom direction
hide empty members
set separator none

package "deep" as deep {
  package "api" as deep.api {
    package "v1" as deep.api.v1 {
      class "handlers" as deep.api.v1.handlers <<(M, #F39C12)>>
      class "schemas" as deep.api.v1.schemas <<(M, #F39C12)>>
    }
  }
  package "core" as deep.core {
    class "models" as deep.core.models <<(M, #1ABC9C)>>
    class "services" as deep.core.services <<(M, #1ABC9C)>>
  }
}

deep.api ---> deep.core
deep.api.v1.handlers ---> deep.api.v1.schemas
deep.core.services ---> deep.core.models
@enduml

