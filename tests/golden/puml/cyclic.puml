@startuml
!theme amiga

top to bottom direction
hide empty members

package pkg_a {
  class pkg_a.core <<(M, #2ECC71)>>
  class pkg_a.services <<(M, #2ECC71)>>
}
package pkg_b {
  class pkg_b.util <<(M, #2ECC71)>>
}

pkg_a <-[#C0392B,bold]-> pkg_b
note on link
  **pkg_a -> pkg_b.util:**
  - core
  - services
  **pkg_b.util -> pkg_a:**
  - core
end note
@enduml

