@startuml
!theme amiga

top to bottom direction
hide empty members

class api.handlers <<(M, #2ECC71)>>
class nest.a <<(M, #2ECC71)>>
class nest.b <<(M, #2ECC71)>>
class ring.a <<(M, #2ECC71)>>
class ring.b <<(M, #2ECC71)>>
class ring.c <<(M, #2ECC71)>>
package services {
  class services.engine <<(M, #2ECC71)>>
  class services.other <<(M, #2ECC71)>>
}

api.handlers -[#C0392B,bold]-> services
nest.a <-[#C0392B,bold]-> nest.b
note on link
  **nest.a -> nest.b:**
  - a → x
  **nest.b -> nest.a:**
  - b → a
end note
ring.a -[#C0392B,bold]-> ring.b
ring.b -[#C0392B,bold]-> ring.c
ring.c -[#C0392B,bold]-> ring.a
services.engine -[#C0392B,bold]-> api.handlers
note as tangle_api_handlers
  **Cycle: api.handlers, services, services.engine**
  **api.handlers -> services:**
  - handlers → services
  **services.engine -> api.handlers:**
  - engine → handlers
  **services -> services.engine (package facade import, not drawn):**
  - services → engine
end note
tangle_api_handlers .. api.handlers
tangle_api_handlers .. services
tangle_api_handlers .. services.engine
note as tangle_ring_a
  **Cycle: ring.a, ring.b, ring.c**
  **ring.a -> ring.b:**
  - a → b
  **ring.b -> ring.c:**
  - b → c
  **ring.c -> ring.a:**
  - c → a
end note
tangle_ring_a .. ring.a
tangle_ring_a .. ring.b
tangle_ring_a .. ring.c
@enduml

