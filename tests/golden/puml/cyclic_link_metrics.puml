@startuml
!theme amiga

top to bottom direction
hide empty members

package pkg_a <<(P, #95A5A6)>> {
  class pkg_a.core <<(M, #2ECC71)>>
  class pkg_a.services <<(M, #2ECC71)>>
}
package pkg_b <<(P, #95A5A6)>> {
  class pkg_b.util <<(M, #2ECC71)>>
}

pkg_a <-[#C0392B,bold]-> pkg_b : edge_weight=2/1
note on link
  **pkg_a -> pkg_b:**
  - core → util
  - services → util
  **pkg_b -> pkg_a:**
  - util → core
end note
@enduml

