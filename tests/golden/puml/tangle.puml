@startuml
!theme amiga

top to bottom direction
hide empty members
set separator none

package "api" as api {
  class "handlers" as api.handlers <<(M, #2ECC71)>>
}
package "nest" as nest {
  class "a" as nest.a <<(M, #2ECC71)>>
  class "b" as nest.b <<(M, #2ECC71)>>
}
package "ring" as ring {
  class "a" as ring.a <<(M, #2ECC71)>>
  class "b" as ring.b <<(M, #2ECC71)>>
  class "c" as ring.c <<(M, #2ECC71)>>
}
package "services" as services {
  class "engine" as services.engine <<(M, #2ECC71)>>
  class "other" as services.other <<(M, #2ECC71)>>
}

api <-[#C0392B,bold]-> services
note on link
  **api -> services:**
  - handlers → services
  **services -> api:**
  - engine → handlers
end note
nest.a <-[#C0392B,bold]-> nest.b
note on link
  **nest.a -> nest.b:**
  - a → x
  **nest.b -> nest.a:**
  - b → a
end note
ring.a -[#C0392B,bold]-> ring.b
ring.b -[#C0392B,bold]-> ring.c
ring.c -[#C0392B,bold]-> ring.a
note as tangle_ring__a
  **Cycle: ring.a, ring.b, ring.c**
  **ring.a -> ring.b:**
  - a → b
  **ring.b -> ring.c:**
  - b → c
  **ring.c -> ring.a:**
  - c → a
end note
tangle_ring__a .. ring.a
tangle_ring__a .. ring.b
tangle_ring__a .. ring.c
@enduml

