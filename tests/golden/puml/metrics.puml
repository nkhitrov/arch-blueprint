@startuml
!theme amiga

top to bottom direction
hide empty members

package pkg_a {
  class pkg_a.core <<(M, #2ECC71)>> {
    fan-in: 1
    fan-out: 1
    instability: 0.5
  }
  class pkg_a.services <<(M, #2ECC71)>> {
    fan-in: 0
    fan-out: 1
    instability: 1.0
  }
}
package pkg_b {
  class pkg_b.util <<(M, #2ECC71)>> {
    fan-in: 2
    fan-out: 1
    instability: 0.33
  }
}

pkg_a <-[#C0392B,bold]-> pkg_b
note on link
  **pkg_a -> pkg_b.util:**
  - core
  - services
  **pkg_b.util -> pkg_a:**
  - core
end note
legend right
  fan-in — how many modules depend on this one
  fan-out — how many modules this one depends on
  instability — fan-out / (fan-in + fan-out): 0 is stable, 1 is unstable

  values on this diagram
  fan-in: 0, 1, 2
  fan-out: 1×3
  instability: 0.33, 0.5, 1.0
endlegend

@enduml

